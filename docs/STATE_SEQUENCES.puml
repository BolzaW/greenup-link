@startuml
title Observed State Sequences (T2S)

skinparam state {
  BackgroundColor LightBlue
  BorderColor Blue
  ArrowColor Black
}

state "1. Nominal Cycle: Stop triggered by the car (EV)" as CycleNominal {
  state "A : Idle" as A1
  state "B : Connected" as B1
  state "C : Waiting EV" as C1
  state "D/E : Charging" as DE1
  state "I : Interrupted by EV" as I1
  state "L : Unplugging" as L1

  [*] --> A1
  A1 --> B1 : Plug in
  B1 --> C1 : Station authorizes
  C1 --> DE1 : EV draws current
  DE1 --> I1 : EV stops charging
  I1 --> B1 : Idle plugged in
  B1 --> L1 : Cable removed (SBF:0)
  L1 --> A1 : Released
  A1 --> [*]
}

state "2. Forced Stop by the Station (via local command)" as CycleForce {
  state "A : Idle" as A2
  state "B : Connected" as B2
  state "C : Waiting EV" as C2
  state "D/E : Charging" as DE2
  state "W : Stopping" as W2
  state "M : Stop finished" as M2

  [*] --> A2
  A2 --> B2 : Plug in
  B2 --> C2 : Station authorizes
  C2 --> DE2 : EV draws current
  DE2 --> W2 : T2CNOK command
  W2 --> M2 : Send Session Summary
  M2 --> A2 : Virtual release
  A2 --> [*]
}
@enduml
