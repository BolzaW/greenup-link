@startuml
title Type 2 (T2S) — Nominal & Smart-Charging Sequences (ATmega Firmware)

skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam state {
  BackgroundColor #F5F7FA
  BorderColor #455A64
  BackgroundColor<<idle>> #E8F5E9
  BorderColor<<idle>> #2E7D32
  BackgroundColor<<wait>> #E3F2FD
  BorderColor<<wait>> #1565C0
  BackgroundColor<<charge>> #FFF3E0
  BorderColor<<charge>> #EF6C00
  BackgroundColor<<stop>> #F3E5F5
  BorderColor<<stop>> #6A1B9A
  ArrowColor #37474F
}

state "1. Direct Charge (FM2:0) — EV Stops & Unplugs" as S1 {
  state "A : Idle" as A1 <<idle>>
  state "B : Plugged" as B1 <<wait>>
  state "C : PWM Ready" as C1 <<wait>>
  state "E : Charging (Direct)" as E1 <<charge>>
  state "I : Paused by EV" as I1 <<wait>>
  state "L : Unplugging" as L1 <<stop>>

  [*] --> A1
  A1 --> B1 : Plug EV (T2C=1, lock OK)\nCCCa:xx, CCS:xx, SBF:1, Start, State:B
  B1 --> C1 : Auto-start after 4.5 s (FM2:0, CAU=1)\nPWM on, CC:xx, State:C
  C1 --> E1 : EV draws (CP 9V → 6V ≥ 500 ms)\n6 mA test OK, Contactor 1 closes\nCC:xx, State:E
  E1 --> E1 : 1 Hz telemetry: CPh:Mono, CCI:<I1>\nRAM modulation: CC:07..32
  E1 --> I1 : EV stops / battery full (CP 6V → 9V)\nContactor 1 opens, State:I
  I1 --> B1 : EV resumes (CP → 6V)\nState:B → C → E
  I1 --> L1 : Unplug cable (CP = 12V)\n(after 20 min in I: FCS:1)\nState:L
  L1 --> A1 : SBF:0, WT:..:CT:..:EVplug:..\nUnlock T2S, State:A
  A1 --> [*]
}

state "2. Smart-Charging Gate (FM2:1 + DOK/DNOK)" as S2 {
  state "A : Idle (FM2:1)" as A2 <<idle>>
  state "B : Held by EMS" as B2 <<wait>>
  state "C : PWM Ready" as C2 <<wait>>
  state "D : Charging (Cond.)" as D2 <<charge>>
  state "E : Charging (Direct)" as E2 <<charge>>
  state "W : Ramp-Down" as W2 <<stop>>
  state "L : Unplugging" as L2 <<stop>>

  [*] --> A2 : Pre-armed FM2:1 + DNOK
  A2 --> B2 : Plug EV (lock OK)\nCCCa:xx, CCS:xx, SBF:1, Start, State:B
  B2 --> B2 : Held indefinitely (no PWM)\nWaiting for solar surplus / EMS
  B2 --> C2 : EMS enable (DOK → D:1)\nor front button long press (EM:XX1)\nPWM on, CC:xx, State:C
  C2 --> D2 : EV draws (CP 6V, FM2:1 active)\nContactor 1 closes, State:D
  D2 --> E2 : FM2:0 sent mid-charge\n(no contactor drop) State:E
  E2 --> D2 : FM2:1 sent mid-charge (D=1)\n(no contactor drop) State:D
  D2 --> W2 : EMS disable (DNOK + FM2:1)\nPWM → +12V, wait CP≠6V (≤ 6.1 s)\nState:W
  W2 --> B2 : Contactor 1 opens, cable locked\nSession stays open\nSBF:1, State:B
  B2 --> L2 : Unplug cable (CP = 12V)\nState:L
  L2 --> A2 : SBF:0, WT:..:EVplug:.., Unlock, State:A
  A2 --> [*]
}

state "3. Deferred Start (Dec:) & 30 s EV Wake-Up" as S3 {
  state "B : Delayed (FM2:0)" as B3 <<wait>>
  state "C : Waiting EV" as C3 <<wait>>
  state "E : Charging" as E3 <<charge>>
  state "W : Ramp-Down" as W3 <<stop>>

  [*] --> B3 : EV plugged, Dec:180 / 360 / 540\n(or front button hold 3h/6h/9h)
  B3 --> B3 : Countdown running (no PWM)
  B3 --> C3 : Timer expires (or Dec:0 / T2FOK)\nDec:0, CC:xx, State:C
  C3 --> C3 : EV asleep > 30 s → Wake-up pulse\nCP 0V (3 s) → +12V (0.9 s) → PWM (CC:xx)
  C3 --> E3 : EV wakes up (CP 6V)\nContactor 1 closes, State:E
  E3 --> W3 : Dec:xxx armed mid-charge (T2F=0)\nPWM → +12V, wait CP≠6V (≤ 6.1 s)\nState:W
  W3 --> B3 : Contactor 1 opens, State:B
}
@enduml
