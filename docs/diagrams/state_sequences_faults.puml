@startuml
title Hardware Faults, Safety Interlocks & Power Outage (ATmega Firmware)

skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam state {
  BackgroundColor #F5F7FA
  BorderColor #455A64
  BackgroundColor<<idle>> #E8F5E9
  BorderColor<<idle>> #2E7D32
  BackgroundColor<<wait>> #E3F2FD
  BorderColor<<wait>> #1565C0
  BackgroundColor<<charge>> #FFF3E0
  BorderColor<<charge>> #EF6C00
  BackgroundColor<<stop>> #F3E5F5
  BorderColor<<stop>> #6A1B9A
  BackgroundColor<<fault>> #FFEBEE
  BorderColor<<fault>> #C62828
  ArrowColor #37474F
}

state "1. Recoverable Faults (State:R) & Auto-Reboot (State:X)" as S1 {
  state "Active / Lock / Close" as Op1 <<charge>>
  state "C : Waiting EV" as C1 <<wait>>
  state "R : Fault" as R1 <<fault>>
  state "X : WDT Reboot" as X1 <<fault>>
  state "A : Idle" as A1 <<idle>>

  Op1 --> R1 : • Lock/Unlock fail: E:0001 / E:0002\n• Contactor 1 close fail: E:0008\n• Overcurrent 8 s: E:0010 (T2S) / E:0011 (Dom ≥ 19.2 A)\nOpens contactor, WT/CT, unlocks T2S, State:R
  R1 --> X1 : After 5 s (if fault_count < 4)\nor front button held 5 s\nState:X
  X1 --> A1 : Watchdog reboot → State:A\n(Latched after 4 consecutive faults)

  C1 --> R1 : Missing EV diode detected\nE:0009, unlocks T2S, State:R
  R1 --> A1 : (E:0009 only) EV cable unplugged\nE:0000, State:A (no reboot)
}

state "2. Critical Latched Faults (State:S) — Shunt-Trip MX" as S2 {
  state "D/E/G/H or Check" as Op2 <<charge>>
  state "S : Latched Critical Fault" as S2_fault <<fault>>

  Op2 --> S2_fault : • Contactor 1 welded / open fail (E:0007)\n• 6 mA DC leakage / self-test fail (E:0015)\n100 ms MX shunt-trip pulse, opens contactors\nUnlocks T2S, SBF:0, E:0007 / E:0015, State:S
  S2_fault --> S2_fault : Closes sessions, PWM = 0\nRemains latched until breaker reset / power cycle
}

state "3. Control Pilot Short (State:T) & Ventilation (State:N)" as S3 {
  state "Any State" as Any3 <<wait>>
  state "T : CP Short (0 V)" as T3 <<fault>>
  state "S : Board CP Fault" as S3_fault <<fault>>
  state "A : Idle" as A3 <<idle>>
  state "C/D/E/I/J" as EV3 <<charge>>
  state "N : Ventilation (3 V)" as N3 <<stop>>
  state "B : Plugged" as B3 <<wait>>

  Any3 --> T3 : Control Pilot = 0 V\nOpens active contactor, unlocks T2S\nE:0003, State:T
  T3 --> A3 : Short clears (cable unplugged, CP ≠ 0 V)\nE:0000, State:A
  T3 --> S3_fault : Cable removed yet CP still 0 V\n(internal board short)\nE:0004, State:S (latched)

  EV3 --> N3 : EV requests ventilation (CP = 3 V)\n(from D/E: via State:W ≤ 6.1 s, opens Contactor 1)\nPWM → +12V, State:N
  N3 --> B3 : EV leaves CP = 3 V\nState:B (or State:F if DOM=1)
}

state "4. Mains Power Outage (State:U / State:V — E:0012)" as S4 {
  state "C/D/E/F/G/H/I : Active" as Act4 <<charge>>
  state "A/B/J/M/P/Y : Idle/Wait" as Idle4 <<wait>>
  state "U : Power Loss (Ramp)" as U4 <<fault>>
  state "V : Fatal Power Loss" as V4 <<fault>>
  state "A : Rebooted" as A4 <<idle>>

  Act4 --> U4 : Mains lost ≥ 400 ms\nE:0012, State:U\nPWM → +12V, wait CP≠6V (≤ 6.1 s), opens C1
  U4 --> V4 : State:V
  Idle4 --> V4 : Mains lost ≥ 400 ms\nE:0012, State:V
  V4 --> V4 : Opens C2, unlocks T2S (cap. reserve)\nWT/CT ticket, low-power wait for 230 V
  V4 --> A4 : 230 V mains restored\nSoftware reset (jmp 0x0000) → State:A
}
@enduml
