@startuml
title Machine à États Complète du Firmware Legrand

skinparam state {
  BackgroundColor White
  BorderColor Black
  ArrowColor DimGrey
}

state "A (Repos)" as A
state "R (Défaut)" as R
state "L (Débranchement T2S)" as L

state "États Isolés" {
  state "K (Suspendu Borne)" as K
  state "O (Suspendu DOM)" as O
  state "M (Arrêt Local)" as M
  state "P (Arrêt Local en cours)" as P
}

state "Circuit Type 2 (T2S)" as T2S {
  state "B (Occupée)" as B
  state "C (Attente EV)" as C
  state "D (Charge)" as D
  state "E (Charge var)" as E
  state "I (Suspendu EV)" as I
  state "J (Suspendu EVSE)" as J
  state "N (Suspendu T2S)" as N
}

state "Circuit Domestique" as DOM {
  state "F (Occupée)" as F
  state "G (Charge)" as G
  state "H (Charge var)" as H
}

' Transitions depuis A
A --> A
A --> B
A --> F

' Transitions depuis B
B --> C
B --> F
B --> L

' Transitions depuis C
C --> B
C --> D
C --> E
C --> F
C --> L
C --> N
C --> R
C --> A

' Transitions depuis D
D --> B
D --> E
D --> I
D --> L
D --> N

' Transitions depuis E
E --> B
E --> D
E --> I
E --> L
E --> N

' Transitions depuis F
F --> A
F --> B
F --> G
F --> H
F --> R

' Transitions depuis G
G --> A
G --> B
G --> F
G --> R

' Transitions depuis H
H --> A
H --> B
H --> F
H --> R

' Transitions depuis I
I --> B
I --> F
I --> J
I --> L
I --> N

' Transitions depuis J
J --> B
J --> F
J --> I
J --> L
J --> N

' Transitions depuis K
K --> R
K --> A

' Transitions depuis L
L --> R
L --> A

' Transitions depuis M
M --> P
M --> A

' Transitions depuis N
N --> B
N --> F

' Transitions depuis O
O --> A

' Transitions depuis P
P --> M
P --> R
P --> A

@enduml
